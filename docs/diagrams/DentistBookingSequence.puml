@startuml seq-register
header Dentist Booking Sequence Diagram
footer Page %page% of %lastpage%
title "Register (POST)"

participant "Client" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:auth" as routerAuth
participant "<<controllers>>\n:auth" as controllersAuth
participant "<<model>>\n:User" as modelUser
database "<<MongoDB>>\n:users" as UsersDatabase

client->server ++:req.post('/api/v1/auth/register')
server->routerAuth ++:app.use('/api/v1/auth',auth)
routerAuth -> controllersAuth ++:register()
alt missing name / telephone / email / password
    controllersAuth->client :response 400
else valid input
    controllersAuth->modelUser ++:create({name, telephone, email, password})
    modelUser ->UsersDatabase ++: UserSchema (hash password)
    UsersDatabase --> modelUser --: user
    controllersAuth <-- modelUser --:user
    controllersAuth->client --:response 201 + token\n(400 invalid data / 409 duplicate email)
end
@enduml


@startuml seq-login
header Dentist Booking Sequence Diagram
footer Page %page% of %lastpage%
title "Login (POST)"

participant "Client" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:auth" as routerAuth
participant "<<controllers>>\n:auth" as controllersAuth
participant "<<model>>\n:User" as modelUser
database "<<MongoDB>>\n:users" as UsersDatabase

client->server ++:req.post('/api/v1/auth/login')
server->routerAuth ++:app.use('/api/v1/auth',auth)
routerAuth -> controllersAuth ++:login()
controllersAuth->modelUser ++:findOne({email}).select('+password')
modelUser ->UsersDatabase ++: UserSchema
UsersDatabase --> modelUser --: user
controllersAuth <-- modelUser --:user
controllersAuth->modelUser ++:matchPassword(password)
controllersAuth <-- modelUser --:isMatch
controllersAuth->client --:response 200 + token\n(401 invalid credentials)
@enduml


@startuml seq-logout
header Dentist Booking Sequence Diagram
footer Page %page% of %lastpage%
title "Logout (GET)"

participant "Client" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:auth" as routerAuth
participant "<<middleware>>\n:auth" as middlewareAuth
participant "<<controllers>>\n:auth" as controllersAuth
participant "<<model>>\n:User" as modelUser
database "<<MongoDB>>\n:users" as UsersDatabase

client->server ++:req.get('/api/v1/auth/logout')
server->routerAuth ++:app.use('/api/v1/auth',auth)
routerAuth -> middlewareAuth ++:protect()
middlewareAuth -> controllersAuth ++:logout()
deactivate middlewareAuth
controllersAuth->modelUser ++:updateOne({_id}, {$inc: {tokenVersion: 1}})
modelUser ->UsersDatabase ++: UserSchema
UsersDatabase --> modelUser --: result
controllersAuth <-- modelUser --:result
controllersAuth->client --:response 200 + clear cookie\n(old token is now rejected)
@enduml


@startuml seq-view-dentists
header Dentist Booking Sequence Diagram
footer Page %page% of %lastpage%
title "View Dentists (GET ALL)"

participant "Client" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:dentists" as routerDentists
participant "<<controllers>>\n:dentists" as controllersDentists
participant "<<model>>\n:Dentist" as modelDentist
database "<<MongoDB>>\n:dentists" as DentistsDatabase

client->server ++:req.get('/api/v1/dentists')
server->routerDentists ++:app.use('/api/v1/dentists',dentists)
routerDentists -> controllersDentists ++:getDentists()
controllersDentists->modelDentist ++:find().sort('name')
modelDentist ->DentistsDatabase ++: DentistSchema
DentistsDatabase --> modelDentist --: dentists
controllersDentists <-- modelDentist --:dentists
controllersDentists->client --:response 200
@enduml


@startuml seq-create-booking
header Dentist Booking Sequence Diagram
footer Page %page% of %lastpage%
title "Create Booking (POST)"

participant "Client" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:dentists" as routerDentists
participant "<<router>>\n:appointments" as routerAppointments
participant "<<middleware>>\n:auth" as middlewareAuth
participant "<<controllers>>\n:appointments" as controllersAppointments
participant "<<model>>\n:Dentist" as modelDentist
participant "<<model>>\n:Appointment" as modelAppointment
database "<<MongoDB>>\n:appointments" as AppointmentsDatabase

client->server ++:req.post('/api/v1/dentists/:dentistId/appointments')
server->routerDentists ++:app.use('/api/v1/dentists',dentists)
routerDentists->routerAppointments ++:router.use('/:dentistId/appointments')
routerAppointments -> middlewareAuth ++:protect(), authorize('user')
middlewareAuth -> controllersAppointments ++:addAppointment()
deactivate middlewareAuth
controllersAppointments->modelDentist ++:findById(dentistId)
controllersAppointments <-- modelDentist --:dentist
alt dentist not found
    controllersAppointments->client :response 404
else dentist found
    controllersAppointments->modelAppointment ++:create({apptDate, dentist, user})
    modelAppointment ->AppointmentsDatabase ++: AppointmentSchema\n(unique index on user)
    alt user already has a booking
        AppointmentsDatabase --> modelAppointment : duplicate key error
        controllersAppointments <-- modelAppointment :error 11000
        controllersAppointments->client :response 409
    else first booking
        AppointmentsDatabase --> modelAppointment --: appointment
        controllersAppointments <-- modelAppointment --:appointment
        controllersAppointments->client --:response 201
    end
end
@enduml


@startuml seq-view-bookings
header Dentist Booking Sequence Diagram
footer Page %page% of %lastpage%
title "View Bookings (GET ALL)"

participant "Client" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:appointments" as routerAppointments
participant "<<middleware>>\n:auth" as middlewareAuth
participant "<<controllers>>\n:appointments" as controllersAppointments
participant "<<model>>\n:Appointment" as modelAppointment
database "<<MongoDB>>\n:appointments" as AppointmentsDatabase

client->server ++:req.get('/api/v1/appointments')
server->routerAppointments ++:app.use('/api/v1/appointments',appointments)
routerAppointments -> middlewareAuth ++:protect()
middlewareAuth -> controllersAppointments ++:getAppointments()
deactivate middlewareAuth
alt role = admin
    controllersAppointments->modelAppointment ++:find({}).populate(dentist, user)
else role = user
    controllersAppointments->modelAppointment :find({user: req.user.id}).populate(dentist, user)
end
modelAppointment ->AppointmentsDatabase ++: AppointmentSchema
AppointmentsDatabase --> modelAppointment --: appointments
controllersAppointments <-- modelAppointment --:appointments
controllersAppointments->client --:response 200
@enduml


@startuml seq-edit-booking
header Dentist Booking Sequence Diagram
footer Page %page% of %lastpage%
title "Edit Booking (PUT)"

participant "Client" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:appointments" as routerAppointments
participant "<<middleware>>\n:auth" as middlewareAuth
participant "<<controllers>>\n:appointments" as controllersAppointments
participant "<<model>>\n:Appointment" as modelAppointment
database "<<MongoDB>>\n:appointments" as AppointmentsDatabase

client->server ++:req.put('/api/v1/appointments/:id')
server->routerAppointments ++:app.use('/api/v1/appointments',appointments)
routerAppointments -> middlewareAuth ++:protect(), authorize('admin','user')
middlewareAuth -> controllersAppointments ++:updateAppointment()
deactivate middlewareAuth
controllersAppointments->modelAppointment ++:findById(id)
modelAppointment ->AppointmentsDatabase ++: AppointmentSchema
AppointmentsDatabase --> modelAppointment --: appointment
controllersAppointments <-- modelAppointment --:appointment
alt not owner and not admin
    controllersAppointments->client :response 403
else owner or admin
    controllersAppointments->modelAppointment ++:findByIdAndUpdate(id, {apptDate, dentist})
    modelAppointment ->AppointmentsDatabase ++: AppointmentSchema
    AppointmentsDatabase --> modelAppointment --: appointment
    controllersAppointments <-- modelAppointment --:appointment
    controllersAppointments->client --:response 200
end
@enduml


@startuml seq-delete-booking
header Dentist Booking Sequence Diagram
footer Page %page% of %lastpage%
title "Delete Booking (DELETE)"

participant "Client" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:appointments" as routerAppointments
participant "<<middleware>>\n:auth" as middlewareAuth
participant "<<controllers>>\n:appointments" as controllersAppointments
participant "<<model>>\n:Appointment" as modelAppointment
database "<<MongoDB>>\n:appointments" as AppointmentsDatabase

client->server ++:req.delete('/api/v1/appointments/:id')
server->routerAppointments ++:app.use('/api/v1/appointments',appointments)
routerAppointments -> middlewareAuth ++:protect(), authorize('admin','user')
middlewareAuth -> controllersAppointments ++:deleteAppointment()
deactivate middlewareAuth
controllersAppointments->modelAppointment ++:findById(id)
modelAppointment ->AppointmentsDatabase ++: AppointmentSchema
AppointmentsDatabase --> modelAppointment --: appointment
controllersAppointments <-- modelAppointment --:appointment
alt not owner and not admin
    controllersAppointments->client :response 403
else owner or admin
    controllersAppointments->modelAppointment ++:deleteOne()
    modelAppointment ->AppointmentsDatabase ++: AppointmentSchema
    AppointmentsDatabase --> modelAppointment --: deleted
    controllersAppointments <-- modelAppointment --:deleted
    controllersAppointments->client --:response 200
end
@enduml
